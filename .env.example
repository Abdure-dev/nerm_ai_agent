# NERM
NERM_API_BASE_URL=
NERM_SERVICE_CLIENT_ID=
NERM_SERVICE_CLIENT_SECRET=

# Authentication
CNETID_ISSUER_URL=
CNETID_CLIENT_ID=
CNETID_CLIENT_SECRET=

# ServiceNow
SERVICENOW_BASE_URL=
